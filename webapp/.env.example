# Copy to .env.local (dev) or set in your host's environment (production).

# --- Auth (production: set both) ---
# When RALLY_PASSCODE is set, the whole app requires this shared passcode.
# Leave it unset for local dev / tests (auth is then disabled).
RALLY_PASSCODE=
# A long random string used to sign the auth cookie. If unset, the passcode is
# used as the secret — set a separate value in production.
RALLY_AUTH_SECRET=

# --- Database ---
# Leave BOTH unset for local dev: the app uses a local SQLite file under
# RALLY_DATA_DIR (./data). For Vercel / serverless, point at a Turso database:
#   TURSO_DATABASE_URL=libsql://your-db-name.turso.io
#   TURSO_AUTH_TOKEN=...   (from `turso db tokens create <db>`)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Local-file location (dev / Docker only; ignored when Turso is configured).
RALLY_DATA_DIR=

# --- Photo uploads ---
# On Vercel, create a Blob store and this is injected automatically. When unset,
# uploads are written to RALLY_DATA_DIR/uploads (local dev / Docker).
BLOB_READ_WRITE_TOKEN=
